---
import { loadJobs } from '../lib/jobLoader.js';
import JobGraph from '../components/JobGraph.astro';
import Search from '../components/Search.astro';
import '../styles/global.css';

const allJobs = await loadJobs();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ESA Internships Explorer</title>
  <meta name="description" content="Explore ESA internship opportunities through interactive visualization and search">
  <script is:inline define:vars={{ allJobs }}>
    window.__JOBS_DATA__ = allJobs;
  </script>
</head>
<body>
  <header>
    <h1>🚀 ESA Internships Explorer</h1>
    <p>Explore {allJobs.length} internship opportunities at the European Space Agency</p>
    <div class="search-hint">Press <kbd>Cmd</kbd>+<kbd>K</kbd> or <kbd>Ctrl</kbd>+<kbd>K</kbd> to search</div>
  </header>

  <main>
    <JobGraph jobs={allJobs} />
  </main>

  <footer>
    <p>Data sourced from ESA Career Portal | Last updated November 2025</p>
  </footer>

  <Search jobs={allJobs} />
</body>
</html>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    text-align: center;
    padding: 1.5rem 2rem;
    background: rgba(10, 10, 10, 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid #333;
    z-index: 100;
  }

  header h1 {
    font-size: 1.5rem;
    color: #4a9eff;
    margin-bottom: 0.25rem;
  }

  header p {
    color: #aaa;
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }

  .search-hint {
    font-size: 0.85rem;
    color: #666;
  }

  .search-hint kbd {
    background: #2a2a2a;
    border: 1px solid #444;
    border-radius: 4px;
    padding: 0.15rem 0.4rem;
    font-family: monospace;
    font-size: 0.8rem;
    color: #aaa;
  }

  main {
    margin: 0;
    padding: 0;
  }

  footer {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    text-align: center;
    padding: 0.75rem;
    background: rgba(10, 10, 10, 0.95);
    backdrop-filter: blur(10px);
    border-top: 1px solid #333;
    color: #888;
    font-size: 0.85rem;
    z-index: 100;
  }

  @media (max-width: 768px) {
    header h1 {
      font-size: 1.2rem;
    }
    
    header p {
      font-size: 0.8rem;
    }

    .search-hint {
      font-size: 0.75rem;
    }
  }
</style>
