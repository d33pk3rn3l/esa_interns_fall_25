---
const { jobs } = Astro.props;
---

<div id="search-modal" class="search-modal" style="display: none;">
  <div class="search-modal-backdrop"></div>
  <div class="search-modal-content">
    <div class="search-header">
      <input 
        type="search" 
        id="search-box" 
        placeholder="Search jobs by title, location, directorate, or description..." 
        autocomplete="off"
      />
      <button id="search-close" class="search-close" aria-label="Close search">×</button>
    </div>
    <div id="search-results"></div>
  </div>
</div>

<script>
  import Fuse from 'fuse.js';

  const jobs = window.__JOBS_DATA__;

  const fuse = new Fuse(jobs, {
    keys: [
      'Title',
      'Workplace',
      'directorate',
      'description_text',
      'sections',
      'bullets',
      'competencies',
      'Vacancy Type',
      'hiring_organization',
      'contract_type',
      'publication'
    ],
    threshold: 0.3,
    includeScore: true,
    includeMatches: true,
    ignoreLocation: true,
    useExtendedSearch: false,
  });

  const searchModal = document.getElementById('search-modal');
  const searchBox = document.getElementById('search-box');
  const resultsDiv = document.getElementById('search-results');
  const closeBtn = document.getElementById('search-close');

  // Open search modal with Cmd/Ctrl+K
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openSearch();
    }
    
    // Close on Escape
    if (e.key === 'Escape' && searchModal.style.display === 'block') {
      closeSearch();
    }
  });

  // Close button click
  closeBtn.addEventListener('click', closeSearch);

  // Close on backdrop click
  searchModal.addEventListener('click', (e) => {
    if (e.target === searchModal || e.target.classList.contains('search-modal-backdrop')) {
      closeSearch();
    }
  });

  function openSearch() {
    searchModal.style.display = 'block';
    setTimeout(() => searchBox.focus(), 100);
  }

  function closeSearch() {
    searchModal.style.display = 'none';
    searchBox.value = '';
    resultsDiv.innerHTML = '';
  }

  function highlightMatches(text, matches) {
    if (!text || !matches || matches.length === 0) return text;
    
    // Sort matches by index in descending order to avoid index shifting
    const sortedMatches = [...matches].sort((a, b) => b[0] - a[0]);
    
    let result = text;
    for (const [start, end] of sortedMatches) {
      const before = result.substring(0, start);
      const match = result.substring(start, end + 1);
      const after = result.substring(end + 1);
      result = before + '<mark>' + match + '</mark>' + after;
    }
    
    return result;
  }

  function getHighlightedText(item, matches, key) {
    const value = item[key];
    if (!value) return value || 'N/A';
    
    const matchesForKey = matches?.filter(m => m.key === key);
    if (!matchesForKey || matchesForKey.length === 0) return value;
    
    return highlightMatches(value, matchesForKey[0].indices);
  }

  function getDescriptionSnippet(item, matches) {
    // Look for matches in description_text, sections, or bullets
    const descriptionKeys = ['description_text', 'sections', 'bullets'];
    let snippet = '';
    
    for (const key of descriptionKeys) {
      const matchesForKey = matches?.filter(m => m.key === key);
      if (matchesForKey && matchesForKey.length > 0 && item[key]) {
        const text = item[key];
        const matchIndices = matchesForKey[0].indices[0];
        if (matchIndices) {
          const [start, end] = matchIndices;
          // Extract context around the match (100 chars before and after)
          const contextStart = Math.max(0, start - 100);
          const contextEnd = Math.min(text.length, end + 100);
          let context = text.substring(contextStart, contextEnd);
          
          // Add ellipsis if truncated
          if (contextStart > 0) context = '...' + context;
          if (contextEnd < text.length) context = context + '...';
          
          // Highlight the match within the snippet
          const relativeStart = start - contextStart + (contextStart > 0 ? 3 : 0);
          const relativeEnd = end - contextStart + (contextStart > 0 ? 3 : 0);
          snippet = highlightMatches(context, [[relativeStart, relativeEnd]]);
          break;
        }
      }
    }
    
    return snippet;
  }

  searchBox.addEventListener('input', (e) => {
    const query = e.target.value.trim();
    
    if (!query) {
      resultsDiv.innerHTML = '';
      return;
    }

    const results = fuse.search(query);
    
    if (results.length === 0) {
      resultsDiv.innerHTML = '<p class="no-results">No jobs found matching your search.</p>';
      return;
    }

    resultsDiv.innerHTML = results.slice(0, 10).map(({ item, matches }) => {
      const snippet = getDescriptionSnippet(item, matches);
      return `
        <div class="result-card">
          <h3>${getHighlightedText(item, matches, 'Title') || 'Untitled Position'}</h3>
          <div class="result-meta">
            <span class="location">📍 ${getHighlightedText(item, matches, 'Workplace') || 'N/A'}</span>
            <span class="directorate">🏢 ${getHighlightedText(item, matches, 'directorate') || 'N/A'}</span>
          </div>
          ${snippet ? `<div class="description-snippet">${snippet}</div>` : ''}
          ${item['Closing Date'] ? `<div class="closing-date">⏰ Closes: ${item['Closing Date']}</div>` : ''}
          <a href="${item.Link || '#'}" target="_blank" rel="noopener noreferrer" class="apply-link">View Details →</a>
        </div>
      `;
    }).join('');
  });
</script>

<style>
  .search-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: var(--z-modal);
  }

  .search-modal[style*="display: block"] {
    display: flex !important;
    align-items: center;
    justify-content: center;
  }

  .search-modal-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(4px);
  }

  .search-modal-content {
    position: relative;
    width: min(90%, 650px);
    max-width: 650px;
    max-height: 85vh;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    margin: var(--spacing-lg);
  }

  .search-header {
    display: flex;
    align-items: center;
    padding: var(--spacing-md) var(--spacing-lg);
    border-bottom: 1px solid #333;
  }

  #search-box {
    flex: 1;
    padding: var(--spacing-sm) var(--spacing-xs);
    font-size: 1rem;
    border: none;
    background: transparent;
    color: var(--text-primary);
    outline: none;
  }

  #search-box::placeholder {
    color: var(--text-muted);
  }

  .search-close {
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
    padding: 0;
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s;
  }

  .search-close:hover {
    color: var(--text-primary);
  }

  #search-results {
    overflow-y: auto;
    padding: var(--spacing-md) var(--spacing-lg);
    flex: 1;
  }

  .result-card {
    background: var(--bg-hover);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--spacing-md) var(--spacing-lg);
    margin-bottom: var(--gap-md);
    transition: transform 0.2s, border-color 0.2s;
  }

  .result-card:hover {
    transform: translateY(-2px);
    border-color: var(--primary-blue);
  }

  .result-card:last-child {
    margin-bottom: 0;
  }

  .result-card h3 {
    margin: 0 0 var(--spacing-sm) 0;
    color: var(--primary-blue);
    font-size: 1.05rem;
    line-height: 1.3;
  }

  .result-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-sm);
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .description-snippet {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin: var(--spacing-sm) 0;
    line-height: 1.5;
    font-style: italic;
  }

  .closing-date {
    font-size: 0.85rem;
    color: #ff9966;
    margin-bottom: var(--spacing-sm);
  }

  .apply-link {
    display: inline-block;
    color: var(--primary-blue);
    text-decoration: none;
    font-weight: 500;
    margin-top: var(--spacing-sm);
  }

  .apply-link:hover {
    text-decoration: underline;
  }

  .no-results {
    color: var(--text-muted);
    text-align: center;
    padding: var(--spacing-xl);
  }

  mark {
    background: rgba(74, 158, 255, 0.3);
    color: var(--text-primary);
    padding: 0.1rem 0.2rem;
    border-radius: var(--radius-sm);
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .search-modal-content {
      width: 95%;
      max-height: 90vh;
      border-radius: var(--radius-md);
      margin: var(--spacing-sm);
    }

    .search-header {
      padding: var(--spacing-sm) var(--spacing-md);
    }

    #search-box {
      font-size: 0.95rem;
      padding: var(--spacing-sm) var(--spacing-xs);
    }

    #search-results {
      padding: var(--spacing-sm) var(--spacing-md);
    }

    .result-card {
      padding: var(--spacing-sm) var(--spacing-md);
    }

    .result-card h3 {
      font-size: 1rem;
    }

    .result-meta {
      font-size: 0.8rem;
    }

    .description-snippet {
      font-size: 0.8rem;
    }

    .closing-date {
      font-size: 0.8rem;
    }
  }

  @media (max-width: 480px) {
    .search-modal-content {
      width: 100%;
      height: 100vh;
      max-height: 100vh;
      border-radius: 0;
      margin: 0;
    }

    .search-header {
      padding: var(--spacing-sm);
    }

    #search-box {
      font-size: 0.9rem;
      padding: var(--spacing-xs);
    }

    #search-results {
      padding: var(--spacing-sm);
    }

    .result-card {
      padding: var(--spacing-sm);
      margin-bottom: var(--spacing-sm);
    }

    .result-card h3 {
      font-size: 0.95rem;
    }

    .result-meta {
      font-size: 0.75rem;
      gap: var(--spacing-xs);
    }
  }
</style>
