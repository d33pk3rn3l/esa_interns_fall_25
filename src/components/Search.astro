---
const { jobs } = Astro.props;
---

<div id="search-modal" class="search-modal" style="display: none;">
  <div class="search-modal-backdrop"></div>
  <div class="search-modal-content">
    <div class="search-header">
      <input 
        type="search" 
        id="search-box" 
        placeholder="Search jobs by title, location, directorate, or description..." 
        autocomplete="off"
      />
      <button id="search-close" class="search-close" aria-label="Close search">×</button>
    </div>
    <div id="search-results"></div>
  </div>
</div>

<script>
  import Fuse from 'fuse.js';

  const jobs = window.__JOBS_DATA__;

  const fuse = new Fuse(jobs, {
    keys: ['Title', 'Workplace', 'directorate', 'description_text'],
    threshold: 0.3,
    includeScore: true,
  });

  const searchModal = document.getElementById('search-modal');
  const searchBox = document.getElementById('search-box');
  const resultsDiv = document.getElementById('search-results');
  const closeBtn = document.getElementById('search-close');

  // Open search modal with Cmd/Ctrl+K
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openSearch();
    }
    
    // Close on Escape
    if (e.key === 'Escape' && searchModal.style.display === 'block') {
      closeSearch();
    }
  });

  // Close button click
  closeBtn.addEventListener('click', closeSearch);

  // Close on backdrop click
  searchModal.addEventListener('click', (e) => {
    if (e.target === searchModal || e.target.classList.contains('search-modal-backdrop')) {
      closeSearch();
    }
  });

  function openSearch() {
    searchModal.style.display = 'block';
    setTimeout(() => searchBox.focus(), 100);
  }

  function closeSearch() {
    searchModal.style.display = 'none';
    searchBox.value = '';
    resultsDiv.innerHTML = '';
  }

  searchBox.addEventListener('input', (e) => {
    const query = e.target.value.trim();
    
    if (!query) {
      resultsDiv.innerHTML = '';
      return;
    }

    const results = fuse.search(query);
    
    if (results.length === 0) {
      resultsDiv.innerHTML = '<p class="no-results">No jobs found matching your search.</p>';
      return;
    }

    resultsDiv.innerHTML = results.slice(0, 10).map(({ item }) => `
      <div class="result-card">
        <h3>${item.Title || 'Untitled Position'}</h3>
        <div class="result-meta">
          <span class="location">📍 ${item.Workplace || 'N/A'}</span>
          <span class="directorate">🏢 ${item.directorate || 'N/A'}</span>
        </div>
        ${item['Closing Date'] ? `<div class="closing-date">⏰ Closes: ${item['Closing Date']}</div>` : ''}
        <a href="${item.Link || '#'}" target="_blank" rel="noopener noreferrer" class="apply-link">View Details →</a>
      </div>
    `).join('');
  });
</script>

<style>
  .search-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 1000;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 10vh;
  }

  .search-modal-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(4px);
  }

  .search-modal-content {
    position: relative;
    width: 90%;
    max-width: 600px;
    max-height: 80vh;
    background: #1a1a1a;
    border: 1px solid #444;
    border-radius: 12px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .search-header {
    display: flex;
    align-items: center;
    padding: 1rem;
    border-bottom: 1px solid #333;
  }

  #search-box {
    flex: 1;
    padding: 0.75rem;
    font-size: 1rem;
    border: none;
    background: transparent;
    color: #fff;
    outline: none;
  }

  #search-box::placeholder {
    color: #666;
  }

  .search-close {
    background: none;
    border: none;
    color: #888;
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
    padding: 0;
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s;
  }

  .search-close:hover {
    color: #fff;
  }

  #search-results {
    overflow-y: auto;
    padding: 1rem;
    flex: 1;
  }

  .result-card {
    background: #2a2a2a;
    border: 1px solid #444;
    border-radius: 8px;
    padding: 1rem;
    margin-bottom: 0.75rem;
    transition: transform 0.2s, border-color 0.2s;
  }

  .result-card:hover {
    transform: translateY(-2px);
    border-color: #4a9eff;
  }

  .result-card h3 {
    margin: 0 0 0.5rem 0;
    color: #4a9eff;
    font-size: 1.1rem;
  }

  .result-meta {
    display: flex;
    gap: 1rem;
    margin-bottom: 0.5rem;
    font-size: 0.9rem;
    color: #aaa;
  }

  .closing-date {
    font-size: 0.85rem;
    color: #ff9966;
    margin-bottom: 0.5rem;
  }

  .apply-link {
    display: inline-block;
    color: #4a9eff;
    text-decoration: none;
    font-weight: 500;
    margin-top: 0.5rem;
  }

  .apply-link:hover {
    text-decoration: underline;
  }

  .no-results {
    color: #888;
    text-align: center;
    padding: 2rem;
  }
</style>
